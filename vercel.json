{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build" },
    { "src": "api/*.py", "use": "@vercel/python" }
  ],
  "rewrites": [
    { "source": "/api/python-admin", "destination": "/api/admin.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
